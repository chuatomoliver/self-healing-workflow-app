# Example only; copy to .env next to docker-compose.yml on the server. Never commit real values.
# Public hostname served through Traefik (its DNS A record must point at the server).
APP_HOST=metaflow.example.com
# Docker network shared with Traefik (default: the n8n project's default network).
TRAEFIK_NETWORK=n8n_default
# Use letters and numbers only (it is embedded in DATABASE_URL without encoding).
MYSQL_PASSWORD=
MODEL_API_KEY=
# enabled (default) requires the login below; disabled serves the app without a login.
DEMO_AUTH=enabled
DEMO_USERNAME=
# 16-256 characters.
DEMO_PASSWORD=
# Optional: comma-separated HTTPS origins for outgoing webhooks, e.g. https://hooks.slack.com
WEBHOOK_ALLOWED_ORIGINS=
