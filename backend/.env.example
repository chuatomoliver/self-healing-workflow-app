# Documentation only. Real secrets belong in the backend process environment.
# Keep any local secret file OUTSIDE C:\xampp\htdocs; never use VITE_ for secrets.
NODE_ENV=development
PORT=3001
# Optional for npm.cmd run dev: defaults to XAMPP root with no password on
# 127.0.0.1:3306 and creates the metaflow database automatically.
# For a custom database: mysql://USER:PASSWORD@HOST:3306/DATABASE (injected at runtime).
DATABASE_URL=
# Optional verified-TLS database connection; requires a trusted server certificate.
DATABASE_SSL=false
# Optional Muse connection test only; not needed for workflow persistence.
# Run npm.cmd run muse:setup once on Windows to store it in Credential Manager.
# MODEL_API_KEY can optionally override the saved key; never put a real key here.
MODEL_API_KEY=
# Exact public HTTPS origins allowed for outgoing webhook delivery (comma separated).
WEBHOOK_ALLOWED_ORIGINS=
# Optional development-only exception: an exact http://127.0.0.1:PORT/path receiver.
WEBHOOK_LOCAL_RECEIVER_URL=
# Optional path to the persistent non-secret connection catalog (outside the repository).
# Default: %LOCALAPPDATA%/Metaflow/connections.json on Windows.
WEBHOOK_CONNECTIONS_FILE=
# Webhook credentials can be saved with webhook:secret, or injected as
# WEBHOOK_SECRET_<reference>. Never put real credentials in this example file.
